# Copie para .env e substitua todos os valores marcados com CHANGE_ME.
# Nunca faça commit do arquivo .env real.

# Endpoints regionais fornecidos pelo OCI Cache. Use FQDN, nunca endereço IP.
OCI_CACHE_PRIMARY_FQDN=CHANGE_ME
OCI_CACHE_STANDBY_FQDN=CHANGE_ME
OCI_CACHE_PRIMARY_REPLICAS_FQDN=
OCI_CACHE_STANDBY_REPLICAS_FQDN=
OCI_PRIMARY_REGION=sa-saopaulo-1
OCI_STANDBY_REGION=sa-vinhedo-1
OCI_CACHE_MODE=NON_SHARDED
OCI_CACHE_READ_FROM_REPLICAS=false

# Credenciais do OCI Cache user. Em produção, injete-as via OCI Vault/Secret.
OCI_CACHE_USERNAME=CHANGE_ME
OCI_CACHE_PASSWORD=CHANGE_ME

# OCIDs necessários somente para observação/provisionamento de DR.
OCI_CACHE_PRIMARY_OCID=
OCI_CACHE_STANDBY_OCID=
OCI_CACHE_PROVISIONING_ENABLED=false
OCI_AUTHENTICATION=INSTANCE_PRINCIPAL
OCI_COMPARTMENT_OCID=
OCI_STANDBY_SUBNET_OCID=
OCI_STANDBY_NSG_OCIDS=
OCI_CACHE_DR_NAME=orders-cache-dr
OCI_CACHE_DR_MODE=NON_SHARDED
OCI_CACHE_DR_SHARD_COUNT=3
OCI_CACHE_DR_ENGINE_VERSION=VALKEY_8_1
OCI_CACHE_USER_OCIDS=
OCI_CACHE_BACKUP_OCID=

# Papel desta instância. Desabilite o consumer em deployments somente produtores.
CACHE_CONSUMER_ENABLED=true
SPRING_CACHE_ENABLED=true
APP_ENV=prod
